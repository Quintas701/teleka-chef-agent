# Copia este ficheiro para .env e preenche o que quiseres.
# TUDO e opcional: sem nada, a demo corre em modo mock/offline.

# ---------- IA (texto da receita) ----------
# Groq (gratis): https://console.groq.com/keys
# Deixa vazio para usar o modelo offline (sem IA).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Alternativa Gemini (gratis): https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# ---------- PayPal ----------
# mock  -> respostas simuladas (demo corre sem conta PayPal)
# sandbox -> usa a sandbox real (preenche as credenciais abaixo)
PAYPAL_MODE=mock
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Payouts: os emails dos vendedores em data/catalog.json tem de ser contas
# sandbox REAIS e DIFERENTES da conta business dona da app (nao podes pagar a ti
# proprio). Cria-as em developer.paypal.com > Testing Tools > Sandbox Accounts.
